{
  "name": "ror2-unlocker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.28.5",
  "scripts": {
    "dev": "vite --mode desktop --host 127.0.0.1",
    "build": "pnpm build:wasm && tsc --noEmit && vite build --mode desktop",
    "check": "pnpm build:wasm && tsc --noEmit && biome check .",
    "format": "biome check --write .",
    "tauri": "tauri",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "test:core": "cargo test -p ror2-profile-core",
    "build:wasm": "node scripts/build-wasm.mjs",
    "web:dev": "pnpm build:wasm && vite --mode web --host 127.0.0.1",
    "web:build": "pnpm build:wasm && tsc --noEmit && vite build --mode web"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@tauri-apps/api": "2.12.3",
    "@tauri-apps/plugin-dialog": "2.8.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@tauri-apps/cli": "2.12.2",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
